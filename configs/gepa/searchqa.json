{
  "builder": "benchmark_adapters:build_benchmark",
  "builder_kwargs": {
    "benchmark": "searchqa",
    "train_items": "packages/searchqa-eval/data/searchqa_split/train/items.json",
    "val_items": "packages/searchqa-eval/data/searchqa_split/val/items.json",
    "test_items": "packages/searchqa-eval/data/searchqa_split/test/items.json",
    "seed_skill": "packages/searchqa-eval/src/searchqa_eval/skills_docs/skillopt_searchqa.md",
    "backend": "api",
    "workers": 32,
    "max_tokens": 4096,
    "max_metric_calls": 2000,
    "max_candidate_proposals": 8,
    "reflection_minibatch_size": 2,
    "seed": 42
  },
  "result_path": "outputs/gepa_searchqa/result.json",
  "validation_result_path": "outputs/gepa_searchqa/validation_eval.json",
  "test_result_path": "outputs/gepa_searchqa/test_eval.json",
  "full_validation_audit": false,
  "full_validation_audit_path": "outputs/gepa_searchqa/judge_full_validation.jsonl"
}
