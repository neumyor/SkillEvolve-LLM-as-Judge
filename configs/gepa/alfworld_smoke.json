  "result_path": "outputs/gepa_alfworld_smoke/result.json",
  "validation_result_path": "outputs/gepa_alfworld_smoke/validation_eval.json",
  "test_result_path": "outputs/gepa_alfworld_smoke/test_eval.json",
  "full_validation_audit": false,
  "full_validation_audit_path": "outputs/gepa_alfworld_smoke/judge_full_validation.jsonl"
