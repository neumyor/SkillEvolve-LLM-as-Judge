{
  "builder": "benchmark_adapters:build_benchmark",
  "builder_kwargs": {
    "benchmark": "alfworld",
    "train_items": "experiments/judgestudy/qwen37_smoke/gepa_aw/train.json",
    "val_items": "experiments/judgestudy/qwen37_smoke/gepa_aw/val.json",
    "test_items": "experiments/judgestudy/qwen37_smoke/gepa_aw/test.json",
    "seed_skill": "packages/alfworld-eval/src/alfworld_eval/skills_docs/skillopt_alfworld.md",
    "env_config": "packages/alfworld-eval/configs/textworld.yaml",
    "backend": "api",
    "max_metric_calls": 1,
    "reflection_minibatch_size": 1,
    "seed": 42,
    "skip_perfect_score": false
