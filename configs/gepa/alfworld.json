{
  "builder": "benchmark_adapters:build_benchmark",
  "builder_kwargs": {
    "benchmark": "alfworld",
    "train_items": "packages/skillopt/data/alfworld_path_split/train/items.json",
    "val_items": "packages/skillopt/data/alfworld_path_split/val/items.json",
    "test_items": "packages/skillopt/data/alfworld_path_split/test/items.json",
    "seed_skill": "packages/alfworld-eval/src/alfworld_eval/skills_docs/skillopt_alfworld.md",
    "env_config": "packages/alfworld-eval/configs/textworld.yaml",
    "backend": "api",
    "workers": 8,
    "max_metric_calls": 300,
    "max_candidate_proposals": 8,
    "reflection_minibatch_size": 2,
    "seed": 42
  },
  "result_path": "outputs/gepa_alfworld/result.json",
  "validation_result_path": "outputs/gepa_alfworld/validation_eval.json",
  "test_result_path": "outputs/gepa_alfworld/test_eval.json",
  "full_validation_audit": false,
  "full_validation_audit_path": "outputs/gepa_alfworld/judge_full_validation.jsonl"
}
