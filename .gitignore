# Python bytecode is never part of the project snapshot.
**/__pycache__/
*.pyc

# Local endpoints and credentials.
benchmark/llm_config.local.json
benchmark/*.local.json
.env
**/.env

# Copied environments and caches are machine-specific and are rebuilt from
# the package lock files when needed.
**/.venv/
**/.venv-*/
**/.uv-cache*/
**/.pytest_cache/
**/.ruff_cache/

# Historical artifacts are versioned separately; new local settings remain ignored.
